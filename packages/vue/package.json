{
  "name": "@alisababivip/vue",
  "version": "0.1.0",
  "description": "Vue 3 wrapper components cho iOS Design System",
  "repository": "https://github.com/alisababivip/ios-design-system.git",
  "homepage": "https://alisababivip.github.io/ios-design-system/",
  "license": "MIT",
  "author": "NLP Group <contact@nlpgroup.vn>",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@alisababivip/tokens": "workspace:*",
    "@alisababivip/core": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.7",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vue": "^3.4.0"
  }
}
