{
  "name": "@nlpgroup/icons",
  "version": "0.1.0",
  "description": "Icon tokens, SVG assets, SF Symbols map & animation keyframes",
  "repository": "https://github.com/alisababivip/ios-design-system.git",
  "homepage": "https://alisababivip.github.io/ios-design-system/",
  "license": "MIT",
  "author": "NLP Group <contact@nlpgroup.vn>",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./css": "./dist/icons.css"
  },
  "files": ["dist", "src/svg"],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate-icons.mjs",
    "build": "node scripts/generate-icons.mjs && tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^5.0.7",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
