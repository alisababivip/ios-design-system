  "description": "NLP Group — iOS-style Atomic Design System & UI Kits (pnpm monorepo)",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
